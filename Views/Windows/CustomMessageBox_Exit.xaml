<Window x:Class="radaway_surcharge_calc_HUN.Views.Windows.CustomMessageBox_Exit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:radaway_surcharge_calc_HUN.Views.Windows"
        mc:Ignorable="d"
                    Title="CustomMessageBox_EXIT" Height="120" Width="230"
    WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" Background="White" 
    BorderBrush="Black" BorderThickness="0.2">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Background="#3333" MouseDown="DragWindow">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="Kilépsz?" FontSize="20" Focusable="False"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="40" Content="-" Background="Transparent" BorderBrush="Transparent" FontSize="20"
                VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Width="40" Content="×" Background="Transparent" BorderBrush="Transparent" FontSize="20"
                VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
                <Button Width="70" Height="40" Margin="0,0,30,0" Background="Transparent" BorderBrush="LightGray" BorderThickness="0.5"
                Content="Igen" FontSize="20" x:Name="Yes" Click="Yes_Click"/>
                <Button Width="70" Height="40" Margin="30,0,0,0" Background="Transparent" BorderBrush="LightGray" BorderThickness="0.5"
                Content="Nem" FontSize="20" x:Name="No" Click="No_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
