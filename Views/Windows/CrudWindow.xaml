<Window x:Class="radaway_surcharge_calc_HUN.Views.Windows.CrudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:radaway_surcharge_calc_HUN.Views.Windows"
        xmlns:UserControls="clr-namespace:radaway_surcharge_calc_HUN.Views.User_Controls"
        mc:Ignorable="d"
        Title="crudWindow" Height="600" Width="900">
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition MaxHeight="200"/>
            <RowDefinition Height="5"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <UserControls:ToolBarMenu Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="10,0,10,10">

            <TabControl>
                <TabItem Header="Felvitel">
                    
                    <Grid Margin="3">
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid Margin="2,2,1,2">
                            
                        </Grid>

                        <Grid Grid.Column="1" Margin="1,2,2,2">
                            
                        </Grid>  
                        
                    </Grid>
                    
                </TabItem>
                
                <TabItem Header="Szerkesztés">

                    <Grid Margin="3">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>



                    </Grid>

                </TabItem>
                
            </TabControl>
            
        </Grid>

        <GridSplitter Grid.Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Height="5"/>

        <Grid Grid.Row="3" Margin="10">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <Grid Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Height="20" Text="Termékcsaládok"></TextBlock>

                <DataGrid VerticalScrollBarVisibility="Auto" Margin="0,20,0,0" Background="Transparent"
                          x:Name="dgProductFamilies"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="True">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding TermekID}" IsReadOnly="True" Width="0.05*"/>
                        <DataGridTextColumn Header="Termékcsalád" Binding="{Binding Termek_Csalad}" Width="0.65*"/>
                        <DataGridTextColumn Header="Vastagság (mm)" Binding="{Binding Uveg_Vastagsag_mm}" Width="0.3*"/>
                    </DataGrid.Columns>
                    
                </DataGrid>
                
            </Grid>

            <GridSplitter Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Height="20" Text="Üvegfelárak"></TextBlock>

                <DataGrid VerticalScrollBarVisibility="Auto" Margin="0,20,0,0" Background="Transparent"
                              x:Name="dgGlassSurcharges"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="True">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ID}" IsReadOnly="True" Width="0.05*"/>
                        <DataGridTextColumn Header="Üveg típus" Binding="{Binding UvegTipus}" Width="0.4*"/>
                        <DataGridTextColumn Header="Vastagság (mm)" Binding="{Binding Vastagsag}" Width="0.20*"/>
                        <DataGridTextColumn Header="Felár (Ft)" Binding="{Binding Felar}" Width="0.35*"/>
                    </DataGrid.Columns>
                    
                </DataGrid>
                
            </Grid>
            
        </Grid>
        
    </Grid>
    
</Window>
