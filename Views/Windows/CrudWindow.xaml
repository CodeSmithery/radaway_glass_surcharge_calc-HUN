<Window x:Class="radaway_surcharge_calc_HUN.Views.Windows.CrudWindow"
        Closing="Window_Closing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:radaway_surcharge_calc_HUN.Views.Windows"
        xmlns:UserControls="clr-namespace:radaway_surcharge_calc_HUN.Views.User_Controls"
        mc:Ignorable="d"
        Title="crudWindow" Height="600" Width="900">
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition MaxHeight="200"/>
            <RowDefinition Height="5"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <UserControls:ToolBarMenu Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*"/>
                <ColumnDefinition Width="0.2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical" 
            HorizontalAlignment="Center" VerticalAlignment="Center">

                <Button x:Name="btSave" Width="100" Height="60" Content="Mentés" 
            Margin="10" Background="LawnGreen" Click="btSave_Click" IsEnabled="False"/>

                <Button x:Name="btDelete" Width="100" Height="60" Content="Törlés" 
            Margin="10" Background="MistyRose" IsEnabled="False" Click="btDelete_Click"/>

            </StackPanel>

            <TabControl x:Name="tabcCreate">
                
                <TabItem Header="Termékcsaládok" x:Name="tabProductFamilies">

                    <Grid Margin="3">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.15*" MinHeight="20"/>
                            <RowDefinition Height="0.85*"/>
                        </Grid.RowDefinitions>

                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Height="20" Text="FELVITEL" FontWeight="Bold"></TextBlock>

                        <Grid Margin="1,2,2,2" Grid.Row="1" x:Name="gdInputPr">

                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                        </Grid>
     
                    </Grid>
                    
                </TabItem>

                <TabItem Header="Üvegfelárak" x:Name="tabGlassSurcharges">

                    <Grid Margin="10">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.15*" MinHeight="20"/>
                            <RowDefinition Height="0.5*"/>
                        </Grid.RowDefinitions>

                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Height="20" Text="FELVITEL" FontWeight="Bold"/>

                        <Grid Margin="2,2,1,2" Grid.Row="1" x:Name="gdInputGl">

                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                        </Grid>

                    </Grid>

                </TabItem>

            </TabControl>
            
        </Grid>

        <GridSplitter Grid.Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Height="5"/>

        <Grid Grid.Row="3" Margin="10">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <Grid Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Height="20" Text="Termékcsaládok"></TextBlock>

                <DataGrid VerticalScrollBarVisibility="Auto" Margin="0,20,0,0" Background="Transparent"
                          x:Name="dgProductFamilies"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CellEditEnding="DgHasChanges"
                          SelectionChanged="dgProductFamilies_SelectionChanged">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding TermekID}" IsReadOnly="True" 
                                            Width="0.05*" />
                        <DataGridTextColumn Header="Termékcsalád" Binding="{Binding Termek_Csalad}" 
                                            Width="0.65*"/>
                        <DataGridTextColumn Header="Üveg Vastagság" Binding="{Binding Uveg_Vastagsag_mm, StringFormat={}{0} mm}" 
                                            Width="0.3*"/>
                    </DataGrid.Columns>
                    
                </DataGrid>
                
            </Grid>

            <GridSplitter Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Height="20" Text="Üvegfelárak"></TextBlock>

                <DataGrid VerticalScrollBarVisibility="Auto" Margin="0,20,0,0" Background="Transparent"
                          x:Name="dgGlassSurcharges"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CellEditEnding="DgHasChanges"
                          SelectionChanged="dgGlassSurcharges_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding FelarID}" IsReadOnly="True" Width="0.05*"/>
                        <DataGridTextColumn Header="Üveg típus" Binding="{Binding Uveg_Tipus}" Width="0.4*"/>
                        <DataGridTextColumn Header="Üveg Vastagság" Binding="{Binding Uveg_Vastagsag_mm, StringFormat={}{0} mm}" Width="0.30*"/>
                        <DataGridTextColumn Header="Felár" Binding="{Binding Felar_ft, StringFormat={}{0:N0}.- Ft}" Width="0.25*"/>
                    </DataGrid.Columns>
                    
                </DataGrid>
                
            </Grid>
            
        </Grid>
        
    </Grid>
    
</Window>
