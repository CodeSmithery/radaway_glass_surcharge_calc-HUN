<UserControl x:Class="radaway_surcharge_calc_HUN.Views.User_Controls.ToolBarMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:radaway_surcharge_calc_HUN.Views.User_Controls"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="600">
    <Grid>
        <Menu Height="25" VerticalAlignment="Top" Background="AntiqueWhite" FontSize="15" VerticalContentAlignment="Center">
            <MenuItem x:Name="p1" Header="Fájl" IsEnabled="{Binding IsCrudMenuOn, RelativeSource={RelativeSource AncestorType=Window}}">
                <MenuItem Header="Adatbázis újragenerálása" x:Name="Database_Reset" Click="Database_Reset_Click"/>
                <MenuItem Header="Export">
                    <MenuItem Header="Termékcsalád tábla" x:Name="PR_Export" Click="Export_Click"/>
                    <MenuItem Header="Üvegfelár tábla" x:Name="GS_Export" Click="Export_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Adatmódosítás" IsEnabled="{Binding IsCrudMenuOn, RelativeSource={RelativeSource AncestorType=Window}}" x:Name="miCRUD" Click="miCRUD_Click"/>
            <MenuItem x:Name="p2" Header="Mentés" 
                      Command="{Binding SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <MenuItem x:Name="Help" Header="Segítség" Click="Help_Click" Tag="https://radaway.hu/zuhanykabin-uveg#:~:text=Factory%20/%20Mirror-,%C3%9Cvegfel%C3%A1rak,-%C3%9Cvegfel%C3%A1rakat%20az%20al%C3%A1bbi"/>
            <MenuItem x:Name="Exit"  Header="Kilépés" Click="Exit_Click"/>
        </Menu>
    </Grid>
</UserControl>
