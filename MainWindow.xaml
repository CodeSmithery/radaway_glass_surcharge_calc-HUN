<Window x:Class="radaway_surcharge_calc_HUN.MainWindow"
        Closing="Window_Closing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:radaway_surcharge_calc_HUN"
        xmlns:UserControls="clr-namespace:radaway_surcharge_calc_HUN.Views.User_Controls"
        mc:Ignorable="d"
        Title="Üvegfelár kalkulátor" Height="550" Width="450">
    <Grid>
        <Grid>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="0.65*" MinHeight="250"/>
                <RowDefinition Height="0.35*" MinHeight="60"/>
            </Grid.RowDefinitions>
            
            <UserControls:ToolBarMenu/>

            <Grid Grid.Row="1" x:Name="gdCalculator" Margin="15,5,15,15">

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.35*"/>
                    <ColumnDefinition Width="0.65*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="LightGray" Margin="2,4,2,2"/>
                <Border Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="LightGray" Margin="2"/>
                <Border Grid.Row="2" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="LightGray" Margin="2"/>
                <Border Grid.Row="3" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="LightGray" Margin="2"/>
                <Border Grid.Row="4" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="LightGray" Margin="2,2,2,4"/>

                <Label Content="Termékcsalád: " Grid.Row="0"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       FontWeight="Bold" FontSize="16"/>
                <Label Content="Üveg vastagsága: " Grid.Row="1"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       FontWeight="Bold" FontSize="16"/>
                <Label Content="Oldalszám: " Grid.Row="2"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       FontWeight="Bold" FontSize="16"/>
                <Label Content="Alapár: " Grid.Row="3"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       FontWeight="Bold" FontSize="16"/>
                <Label Content="Üveg típusa: " Grid.Row="4"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       FontWeight="Bold" FontSize="16"/>
            </Grid>

            <Grid Grid.Row="2" x:Name="gdOutput" Margin="15,5,15,15">
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.4*" MinHeight="30"/>
                    <RowDefinition Height="0.6*" MinHeight="90"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="1" MaxHeight="65" MaxWidth="180" Content="SZÁMOL" 
                        FontSize="35" x:Name="btnCalculate"
                        IsEnabled="{Binding CanCalculate}" Click="btnCalculate_Click"/>

            </Grid>

        </Grid>
    </Grid>
</Window>
